<Window x:Class="JELMusic.Studio.VideoProjectDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Proyecto de v&#237;deo"
        Width="720"
        Height="620"
        MinWidth="620"
        MinHeight="520"
        WindowStartupLocation="CenterOwner"
        Background="#151515">

    <Grid Margin="32">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="NameTextBlock"
                   Grid.Row="0"
                   FontSize="30"
                   FontWeight="SemiBold"
                   Foreground="White"/>

        <TextBlock Text="Informaci&#243;n del proyecto audiovisual"
                   Grid.Row="1"
                   FontSize="14"
                   Foreground="#AAAAAA"
                   Margin="0,8,0,28"/>

        <StackPanel Grid.Row="2">

            <TextBlock Text="Proyecto musical"
                       FontSize="13"
                       Foreground="#888888"/>

            <TextBlock x:Name="MusicalProjectIdTextBlock"
                       FontSize="15"
                       Foreground="#CCCCCC"
                       Margin="0,4,0,22"/>

            <TextBlock Text="Concepto"
                       FontSize="13"
                       Foreground="#888888"/>

            <TextBlock x:Name="ConceptTextBlock"
                       FontSize="16"
                       Foreground="White"
                       TextWrapping="Wrap"
                       Margin="0,4,0,22"/>

            <TextBlock Text="Duraci&#243;n"
                       FontSize="13"
                       Foreground="#888888"/>

            <TextBlock x:Name="DurationTextBlock"
                       FontSize="16"
                       Foreground="#CCCCCC"
                       Margin="0,4,0,22"/>

            <TextBlock Text="Estado"
                       FontSize="13"
                       Foreground="#888888"/>

            <TextBlock x:Name="StatusTextBlock"
                       FontSize="16"
                       Foreground="#CCCCCC"
                       Margin="0,4,0,22"/>

            <TextBlock Text="Creado"
                       FontSize="13"
                       Foreground="#888888"/>

            <TextBlock x:Name="CreatedAtTextBlock"
                       FontSize="16"
                       Foreground="#CCCCCC"
                       Margin="0,4,0,0"/>

        </StackPanel>

        <Button Grid.Row="3"
                Content="Cerrar"
                Width="110"
                Height="42"
                HorizontalAlignment="Right"
                Margin="0,24,0,0"
                Click="Close_Click"/>

    </Grid>

</Window>
