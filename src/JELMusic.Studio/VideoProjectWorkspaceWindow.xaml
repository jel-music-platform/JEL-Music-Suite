<Window x:Class="JELMusic.Studio.VideoProjectWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JEL-Music Studio"
        Width="1200"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#111111">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock x:Name="NameTextBlock"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock Text="Espacio de trabajo del videoclip"
                           FontSize="14"
                           Foreground="#999999"
                           Margin="0,6,0,0"/>

            </StackPanel>

            <Border Grid.Column="1"
                    Background="#252525"
                    CornerRadius="6"
                    Padding="14,8"
                    VerticalAlignment="Center">

                <TextBlock x:Name="StatusTextBlock"
                           FontSize="13"
                           Foreground="#CCCCCC"/>

            </Border>

        </Grid>

        <!-- Área principal -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Información -->

            <Border Grid.Column="0"
                    Background="#191919"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,16,0">

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                    <TextBlock Text="INFORMACIÓN"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#888888"/>

                    <TextBlock Text="Concepto"
                               FontSize="12"
                               Foreground="#777777"
                               Margin="0,24,0,4"/>

                    <TextBlock x:Name="ConceptTextBlock"
                               FontSize="14"
                               Foreground="White"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Duración"
                               FontSize="12"
                               Foreground="#777777"
                               Margin="0,24,0,4"/>

                    <TextBlock x:Name="DurationTextBlock"
                               FontSize="14"
                               Foreground="#CCCCCC"/>
                                          <TextBlock Text="NUEVA ESCENA"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#888888"
                               Margin="0,24,0,12"/>
                                         <TextBlock Text="Nombre"
                               FontSize="12"
                               Foreground="#777777"
                               Margin="0,0,0,4"/>

                    <TextBox x:Name="NewSceneNameTextBox"
                             Height="30"
                             Padding="6,4"
                             Background="#252525"
                             Foreground="White"
                             BorderBrush="#555555"
                             Margin="0,0,0,10"/>

                   <TextBlock Text="Inicio (mm:ss)"
                               FontSize="12"
                               Foreground="#777777"
                               Margin="0,0,0,4"/>

                    <TextBox x:Name="NewSceneStartTimeTextBox"
                             Text="00:00"
                             Height="30"
                             Padding="6,4"
                             Background="#252525"
                             Foreground="White"
                             BorderBrush="#555555"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Final (mm:ss)"
                               FontSize="12"
                               Foreground="#777777"
                               Margin="0,0,0,4"/>

                    <TextBox x:Name="NewSceneEndTimeTextBox"
                             Text="00:30"
                             Height="30"
                             Padding="6,4"
                             Background="#252525"
                             Foreground="White"
                             BorderBrush="#555555"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Descripción"
                               FontSize="12"
                               Foreground="#777777"
                               Margin="0,0,0,4"/>

                    <TextBox x:Name="NewSceneDescriptionTextBox"
                             Height="60"
                             Padding="6,4"
                             Background="#252525"
                             Foreground="White"
                             BorderBrush="#555555"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,10"/>

                    <Button x:Name="CreateSceneButton"
                            Content="Crear escena"
                            Height="34"
                            Background="#BE5A1E"
                            Foreground="White"
                            BorderThickness="0"
                            Click="CreateSceneButton_Click"
                            Margin="0,0,0,18"/>

                   <TextBlock Text="EDITAR ESCENA"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#888888"
                               Margin="0,30,0,12"/>

                   <TextBlock Text="Nombre de la escena"
                               FontSize="12"
                               Foreground="#777777"
                               Margin="0,0,0,4"/>

                    <TextBox x:Name="SceneNameTextBox"
                             Height="30"
                             Padding="6,4"
                             Background="#252525"
                             Foreground="White"
                             BorderBrush="#555555"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Descripción"
                               FontSize="12"
                               Foreground="#777777"
                               Margin="0,0,0,4"/>

                    <TextBox x:Name="SceneDescriptionTextBox"
                             MinHeight="70"
                             MaxHeight="110"
                             Padding="6,4"
                             Background="#252525"
                             Foreground="White"
                             BorderBrush="#555555"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,12"/>

                    <TextBlock Text="Inicio (mm:ss)"
                               FontSize="12"
                               Foreground="#777777"
                               Margin="0,0,0,4"/>

                    <TextBox x:Name="SceneStartTimeTextBox"
                             Text="00:00"
                             Height="30"
                             Padding="6,4"
                             Background="#252525"
                             Foreground="White"
                             BorderBrush="#555555"
                             Margin="0,0,0,10"
                             TextChanged="SceneTimingTextBox_TextChanged"/>

                    <TextBlock Text="Final (mm:ss)"
                               FontSize="12"
                               Foreground="#777777"
                               Margin="0,0,0,4"/>

                    <TextBox x:Name="SceneEndTimeTextBox"
                             Text="00:00"
                             Height="30"
                             Padding="6,4"
                             Background="#252525"
                             Foreground="White"
                             BorderBrush="#555555"
                             Margin="0,0,0,10"
                             TextChanged="SceneTimingTextBox_TextChanged"/>

                    <TextBlock Text="Duración de la escena"
                               FontSize="12"
                               Foreground="#777777"
                               Margin="0,0,0,4"/>

                    <TextBlock x:Name="SceneDurationTextBlock"
                               Text="00:00"
                               FontSize="14"
                               Foreground="#CCCCCC"
                               Margin="0,0,0,14"/>

                    <Button x:Name="SaveSceneTimingButton"
                            Content="Guardar cambios"
                            Height="34"
                            Background="#BE5A1E"
                            Foreground="White"
                            BorderThickness="0"
                            Click="SaveSceneTimingButton_Click"/>

                 </StackPanel>

             </ScrollViewer>

         </Border>

            <!-- Área audiovisual -->

            <Border Grid.Column="1"
                    Background="#191919"
                    CornerRadius="8">

                <Grid>
                    <TextBlock Text="ÁREA DE TRABAJO"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="18"
                               Foreground="#555555"/>

                </Grid>

</Border>

        </Grid>


              <Border Grid.Row="2"
                      Background="#191919"
                      CornerRadius="8"
                      Margin="0,20,0,0"
                      Padding="20">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <TextBlock Text="LíNEA TEMPORAL"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#888888"/>

                <Grid Grid.Row="1"
                      Margin="0,18,0,0">

                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="34"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <Canvas x:Name="TimelineRuler"
                            Grid.Row="0"
                            Height="24"/>

<Border x:Name="TimelineTrack"
        Grid.Row="1"
        Background="#252525"
        CornerRadius="4"
        VerticalAlignment="Center"
        ClipToBounds="True"
        MouseLeftButtonDown="TimelineTrack_MouseLeftButtonDown">

    <Grid>

    <Canvas x:Name="TimelineScenesCanvas"
            IsHitTestVisible="False"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"/>

    <Border x:Name="Playhead"
            Width="2"
            Height="34"
            Background="#DDDDDD"
            HorizontalAlignment="Left"
            VerticalAlignment="Center"
            Margin="0,0,0,0"/>

   </Grid>

</Border>

                    <TextBlock x:Name="TimelineDurationTextBlock"
                               Grid.Row="2"
                               HorizontalAlignment="Right"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="#888888"/>

                    <TextBlock x:Name="TimelineSelectedTimeTextBlock"
                               Grid.Row="2"
                               HorizontalAlignment="Left"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="#CCCCCC"
                               Text="00:00"/>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</Window>
