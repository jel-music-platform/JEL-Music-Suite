<Window x:Class="JELMusic.Studio.VideoProjectWorkspaceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JEL-Music Studio"
        Width="1200"
        Height="760"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterOwner"
        Background="#111111">

    <Grid Margin="24">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>

        <!-- Cabecera -->

        <Grid Grid.Row="0"
              Margin="0,0,0,20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">

                <TextBlock x:Name="NameTextBlock"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="White"/>

                <TextBlock Text="Espacio de trabajo del videoclip"
                           FontSize="14"
                           Foreground="#999999"
                           Margin="0,6,0,0"/>

            </StackPanel>

            <Border Grid.Column="1"
                    Background="#252525"
                    CornerRadius="6"
                    Padding="14,8"
                    VerticalAlignment="Center">

                <TextBlock x:Name="StatusTextBlock"
                           FontSize="13"
                           Foreground="#CCCCCC"/>

            </Border>

        </Grid>

        <!-- Área principal -->

        <Grid Grid.Row="1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="260"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Información -->

            <Border Grid.Column="0"
                    Background="#191919"
                    CornerRadius="8"
                    Padding="20"
                    Margin="0,0,16,0">

                <StackPanel>

                    <TextBlock Text="INFORMACIÓN"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="#888888"/>

                    <TextBlock Text="Concepto"
                               FontSize="12"
                               Foreground="#777777"
                               Margin="0,24,0,4"/>

                    <TextBlock x:Name="ConceptTextBlock"
                               FontSize="14"
                               Foreground="White"
                               TextWrapping="Wrap"/>

                    <TextBlock Text="Duración"
                               FontSize="12"
                               Foreground="#777777"
                               Margin="0,24,0,4"/>

                    <TextBlock x:Name="DurationTextBlock"
                               FontSize="14"
                               Foreground="#CCCCCC"/>

                </StackPanel>

            </Border>

            <!-- Área audiovisual -->

            <Border Grid.Column="1"
                    Background="#191919"
                    CornerRadius="8">

                <Grid>

                    <TextBlock Text="ÁREA DE TRABAJO"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="18"
                               Foreground="#555555"/>

                </Grid>

            </Border>

        </Grid>

        <!-- Línea temporal -->

        <Border Grid.Row="2"
                Background="#191919"
                CornerRadius="8"
                Margin="0,20,0,0"
                Padding="20">

            <Grid>

                <TextBlock Text="LÍNEA TEMPORAL"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="#888888"
                           VerticalAlignment="Top"/>

                <TextBlock Text="Las escenas del videoclip aparecerán aquí."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Foreground="#555555"/>

            </Grid>

        </Border>

    </Grid>

</Window>